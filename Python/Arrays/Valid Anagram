class Solution:
    def isAnagram(self, s: str, t: str) -> bool:
        #method1 
        # sa = ''.join(sorted(s))
        # ta = ''.join(sorted(t))


        # return sa==ta

        #method 2
        freq = {}
        for i in s:
            freq[i] = freq.get(i,0) + 1

        for i in t:
            freq[i] = freq.get(i,0) - 1

        for key in freq:
            if freq[key] !=0:
                return False
        return True
        
        
        
