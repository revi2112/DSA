class Solution {
    public int[] topKFrequent(int[] nums, int k) {
        //approch 1 freq and sort the array based on freq and get top 2
        // how to sort based on freq arr[[count, num]] and sort.

        HashMap<Integer, Integer> hmap  = new HashMap<>();

        for (int num : nums) {
    hmap.put(num, hmap.getOrDefault(num, 0) + 1);
}
        // now iterate through each entry and create an arraylist
        List<int[]> arr = new ArrayList<>();
        for(Map.Entry<Integer, Integer> entry: hmap.entrySet()){
            arr.add(new int[] {entry.getValue(), entry.getKey()});
        }
        // sort on freq descding
        arr.sort((a,b) -> b[0]-a[0]);

        int[] res = new int[k];
        for (int i = 0; i < k; i++) {
            res[i] = arr.get(i)[1];
        }
        return res;
    }
}
/ aproch 2 for k elemnets we are sorking the entire list
        // min heap of size k and smalled stays on top and it get replaced 
        //O(m log k) Every push/pop costs O(log k)
        
        // min heap ([count, num]) no need to sort
        // keep size <=k
        PriorityQueue<int[]> heap = new PriorityQueue<>((a,b)->a[0]-b[0]);
        for(Map.Entry<Integer, Integer> entry: hmap.entrySet()){
            heap.offer(new int[]{entry.getValue(), entry.getKey()});
            if(heap.size() > k){
                heap.poll();
            }
        }

        //result 
        int[] res = new int[k];

        for(int i =0; i<k;i++){
            res[i] = heap.poll()[1];
        }
        return res;



    }
}
